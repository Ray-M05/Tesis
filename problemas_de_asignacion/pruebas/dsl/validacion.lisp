(in-package :pruebas-dsl)

(let ((claves (dsl-ast::repartir-claves '(:a 1 2 :b 3) '(:a :b) "x")))
  (assert (equal (getf claves :a) '(1 2)))
  (assert (equal (getf claves :b) '(3)))
  (assert (= (dsl-ast::valor-unico claves :b "x") 3)))

(flet ((falla (funcion &rest fragmentos)
         (handler-case (progn (funcall funcion)
                              (error "No se rechazó"))
           (error-dsl (condicion)
             (dolist (fragmento fragmentos)
               (assert (search fragmento (princ-to-string condicion))))))))
  (falla (lambda () (dsl-ast::repartir-claves '(:c 1) '(:a) "x")) "x" ":C")
  (falla (lambda () (dsl-ast::repartir-claves '(:a 1 :a 2) '(:a) "x")) "repetida")
  (falla (lambda () (dsl-ast::repartir-claves '(:a) '(:a) "x")) "sin valor")
  (falla (lambda () (dsl-ast::valor-unico '() :a "x")) "falta")
  (falla (lambda () (dsl-ast::valor-unico '(:a (1 2)) :a "x")) "un solo valor")
  (falla (lambda () (dsl-ast::exigir-nombre-propio 'list "x")) "LIST")
  (falla (lambda () (dsl-ast::exigir-nombre-propio 't "x")) "T")
  (falla (lambda () (dsl-ast::exigir-nombre-propio 3 "x")) "3"))
