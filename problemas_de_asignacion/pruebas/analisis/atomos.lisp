(in-package :pruebas-analisis)

(defun consulta-de-pareja (condicion)
  "Carga una consulta M sobre dos filas con esa condición y devuelve (problema nodo)."
  (let* ((p (problema-de (format nil "(def-consulta m (x)
                                        :pares (a b) fila
                                        :comprueba ~a
                                        :operacion (suma 1))
                                      (def-nppq r (op-mayor (m v) 0) :para (v profesor))"
                                 condicion)))
         (nodo (first (first (dominios-de-parametros p)))))
    (list p nodo)))

(defun papel-en (condicion)
  "Devuelve el papel de una condición en una pareja, con los nombres de sus símbolos."
  (destructuring-bind (p nodo) (consulta-de-pareja condicion)
    (let* ((paquete (symbol-package (slot-value nodo 'nombre)))
           (papel (papel-de (slot-value nodo 'comprobacion)
                            (find-symbol "A" paquete) (find-symbol "B" paquete) p)))
      (nombres (if (eq (first papel) :filtro) (list :filtro (second papel)) papel)))))

;; Ruta y raíz.
(multiple-value-bind (ruta raiz)
    (camino (dsl-ast::def-acceso-a-atributo-de-entidad
              'dia (dsl-ast::def-acceso-a-atributo-de-entidad 'sesion 'u)))
  (assert (equal ruta '(dia sesion)))
  (assert (eq raiz 'u)))
(assert (null (camino 5)))

;; Decisión o dato: depende de la raíz y del slot más cercano a ella.
(let* ((p (problema-de "(def-consulta m ()
                          :itera-sobre (u fila) (a ausencia)
                          :comprueba (op-y (op-igual (dia u) (dia a))
                                             (op-mayor (orden (turno u)) 1)
                                             (op-igual (profesor (sesion u)) (profesor a)))
                          :operacion (suma 1))
                        (def-nppq r (op-mayor (m) 0))"))
       (nodo (first (first (dominios-de-parametros p))))
       (variables (iteradores-de nodo))
       (atomos (aplanar 'op-y (slot-value nodo 'comprobacion)))
       (primero (first atomos))
       (tercero (third atomos)))
  (flet ((decision (acceso) (nombres (decision-de acceso variables p))))
    (assert (equal (decision (slot-value primero 'operando-izq)) "DIA"))
    (assert (null (decision (slot-value primero 'operando-der))))
    (assert (equal (decision (slot-value (second atomos) 'operando-izq)) "TURNO"))
    (assert (null (decision (slot-value tercero 'operando-izq))))
    (assert (null (decision (slot-value tercero 'operando-der)))))
  (assert (equal (nombres (decisiones-de nodo variables p)) '("DIA" "TURNO"))))

;; Un papel por caso.
(assert (equal (papel-en "(op-igual (dia a) (dia b))") '("CELDA" ("DIA"))))
(assert (equal (papel-en "(op-igual (orden (turno a)) (orden (turno b)))")
               '("CELDA" ("ORDEN" "TURNO"))))
(assert (equal (papel-en "(op-igual (profesor (sesion a)) (profesor (sesion b)))")
               '("CLAVE" ("PROFESOR" "SESION"))))
(assert (equal (papel-en "(op-distinto (sesion a) (sesion b))") '("DISTINTO" ("SESION"))))
(assert (equal (papel-en "(op-distinto (dia a) (dia b))") '("DISTINTO" ("DIA"))))
(assert (equal (papel-en "(op-igual (op-suma (orden (dia a)) 1) (orden (dia b)))")
               '("ADYACENTE" ("ORDEN" "DIA"))))
(assert (equal (papel-en "(op-igual (orden (dia a)) (op-suma (orden (dia b)) 1))")
               '("ADYACENTE" ("ORDEN" "DIA"))))
(assert (equal (papel-en "(op-distinto (orden (dia a)) (op-suma (orden (dia b)) 1))")
               '("NO-ADYACENTE" ("ORDEN" "DIA"))))
(dolist (comparador '("op-mayor" "op-menor" "op-mayor-igual" "op-menor-igual"))
  (assert (equal (papel-en (format nil "(~a (orden (dia a)) (orden (dia b)))" comparador))
                 '("ORDEN" ("ORDEN" "DIA")))))
(assert (equal (papel-en "(op-mayor (orden (dia a)) 3)") '("FILTRO" "A")))
(assert (equal (papel-en "(op-menor 3 (orden (dia b)))") '("FILTRO" "B")))
(assert (equal (papel-en "(op-igual (orden (dia a)) 3)") '("FILTRO" "A")))
(assert (equal (papel-en "(op-distinto (orden (dia a)) 3)") '("FILTRO" "A")))
(assert (equal (papel-en "(op-igual (profesor (sesion a)) x)")
               '("ENLACE" "X" ("PROFESOR" "SESION") "A")))
(assert (equal (papel-en "(op-igual x (profesor (sesion b)))")
               '("ENLACE" "X" ("PROFESOR" "SESION") "B")))
(assert (equal (papel-en "(op-o (op-igual (profesor (sesion a)) x)
                                 (op-igual (profesor a) x))")
               '("PAPELES" "X" "A")))

;; Sin papel: otra operación, un op-o de variables o raíces distintas.
(assert (null (papel-en "(op-no (op-igual (dia a) (dia b)))")))
(assert (null (papel-en "(op-o (op-igual (dia a) (dia b)) (op-igual (turno a) (turno b)))")))
(assert (null (papel-en "(op-igual (orden (dia a)) (orden (turno b)))")))
(assert (null (papel-en "(op-o (op-igual (profesor (sesion a)) x)
                                (op-igual (profesor (sesion b)) x))")))

;; Los cinco dominios: tesis lleva los papeles en un op-o sobre una sola fila.
(let* ((p (problema-real "tesis"))
       (nodo (first (first (dominios-de-parametros p))))
       (paquete (symbol-package (slot-value nodo 'nombre)))
       (a (find-symbol "A1" paquete))
       (b (find-symbol "A2" paquete))
       (papeles (mapcar (lambda (atomo) (papel-de atomo a b p))
                        (aplanar 'op-y (slot-value nodo 'comprobacion)))))
  (assert (equal (nombres (mapcar #'first papeles))
                 '("PAPELES" "PAPELES" "CELDA" "CELDA" "DISTINTO"))))
